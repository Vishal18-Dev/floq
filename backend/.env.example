# FLOQ Backend Environment Configuration Template (PostgreSQL)
# Copy this file to .env and configure for your deployment environment (development / staging / production)

# Application Environment
NODE_ENV=production
PORT=4000

# PostgreSQL Managed Database Connection String (Render / AWS RDS / GCP Cloud SQL)
DATABASE_URL=postgresql://floq_user:floq_password_replace@ep-sample-pooler.region.aws.render.com/floq_db?ssl=true

# Security & Authentication
# CRITICAL: Must be a strong random secret (32+ chars) in production!
JWT_SECRET=super_secret_production_jwt_key_replace_this_in_prod

# Data Isolation & Access
CORS_ORIGIN=https://vendor.floq.in,https://app.floq.in

# Feature & Safety Flags
# MUST BE false IN PRODUCTION to prevent mock authentication or payment confirmation
ALLOW_MOCK_AUTH=false
ALLOW_MOCK_PAYMENTS=false

# Production Payment Gateway Credentials (Razorpay / Cashfree)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Production SMS OTP Provider (Twilio / AWS SNS)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Observability
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=info
