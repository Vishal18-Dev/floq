# FLOQ Backend Environment Configuration Template (PostgreSQL)
# Copy this file to .env and configure for your deployment environment.

# Application Environment
NODE_ENV=production
PORT=4000

# PostgreSQL Managed Database Connection String (Render / AWS RDS / GCP Cloud SQL)
DATABASE_URL=postgresql://floq_user:floq_password_replace@host.region.provider.com/floq_db?ssl=true

# Security & Authentication
# CRITICAL: both MUST be set in production/staging — the server refuses to start
# otherwise. Use strong random values (32+ chars). Never reuse the examples.
JWT_SECRET=replace_with_a_long_random_secret_32_chars_min
ADMIN_KEY=replace_with_a_long_random_admin_key

# PIN policy for merchant login (phone + fixed PIN, no SMS OTP)
PIN_LENGTH=4
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# CORS. The APK talks to this host; list any web origins that also call the API.
CORS_ORIGIN=https://your-floq-host.example.com

# Payments: beta uses cash + static UPI QR with manual confirmation (no gateway),
# which is the built-in manual provider. Leave this unset/true for the beta.
# Set to false only once a real payment gateway is integrated.
# ALLOW_MOCK_PAYMENTS=true

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info
